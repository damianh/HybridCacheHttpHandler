<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>DamianH.HttpHybridCacheHandler.ContentStore.Stowage</AssemblyName>
    <RootNamespace>DamianH.HttpHybridCacheHandler.ContentStore.Stowage</RootNamespace>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    <MinVerTagPrefix>cache-stow-v</MinVerTagPrefix>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>DamianH.HttpHybridCacheHandler.ContentStore.Stowage</PackageId>
    <Authors>Damian Hickey</Authors>
    <Description>Stowage-powered large-content store adapter for DamianH.HttpHybridCacheHandler.</Description>
    <PackageTags>http;caching;httpclient;hybridcache;stowage;s3;azure;blob</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/damianh/http-lib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/damianh/http-lib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="MinVer" Version="7.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Stowage" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HttpHybridCacheHandler\HttpHybridCacheHandler.csproj" />
  </ItemGroup>

</Project>
